{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Compile",
            "type": "cppdbg",       // 配置类型，对于C/C++可认为此处只能是cppdbg，由cpptools提供；不同编程语言不同
            "request": "launch",    // 可以为launch（启动）或attach（附加）
            "program": "${workspaceFolder}/build/output/ChineseChess.exe",
            "args": [], // 序调试时传递给程序的命令行参数，一般设为空
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",    // 调试程序时的工作目录，此为工作区文件夹；改成${fileDirname}可变为文件所在目录
            "environment": [], // 环境变量
            "externalConsole": true, // 使用单独的cmd窗口，与其它IDE一致；为false时使用内置终端
            // "console": "externalTerminal",
            "internalConsoleOptions": "neverOpen",
            "MIMode": "gdb",    // 指定连接的调试器，可以为gdb或lldb。
            "miDebuggerPath": "gdb.exe",     // 调试器路径，Windows下后缀不能省略，Linux下则不要
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": false
                },
            ],
            "preLaunchTask": "Make"  // 调试前执行的任务，一般为编译程序。与tasks.json的label相对应
        }

    ]
}